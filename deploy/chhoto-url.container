#
# chhoto-url.container
#
# To be used with rootless quadlets. Put inside your $XDG_CONFIG_HOME/containers/systemd/
# Take a look at README for the explanation of the configs.
# The commented out configs are optional.
[Unit]
Description=Caddy
#AssertPathIsDirectory=%h/podman/chhoto-url/data

[Container]
ContainerName=chhoto-url
Image=docker.io/sintan1729/chhoto-url:alpine
#Image=docker.io/sintan1729/chhoto-url:alpine # for extra convenience
#The images can also be pulled from ghcr.io
PodmanArgs=--tty
PublishPort=4567:4567
DropCapability=ALL
#Memory=50m # Note: This might not work with older versions of podman quadlets

# Environment variables
Environment=CHHOTO_DB_URL=/data/urls.sqlite 
Environment=CHHOTO_SQLITE_USE_WAL_MODE=True 
#Environment=CHHOTO_SQLITE_ENSURE_ACID=True
#Environment=CHHOTO_DISABLE_BACKUPS=False
#Environment=CHHOTO_CUSTOM_SITE_TITLE="Custom Title"
#Environment=CHHOTO_SITE_URL=https://www.example.com 
#Environment=CHHOTO_HASH_ALGORITHM=Argon2 
#Change the password before you run the container
Environment=CHHOTO_PASSWORD=TopSecretPass 
Environment=CHHOTO_EXIT_ON_NO_AUTH=True
# Environment=CHHOTO_OIDC_ISSUER_URL=https://sso.example.com
# Environment=CHHOTO_OIDC_CLIENT_ID=some-random-client-id
# Environment=CHHOTO_OIDC_CUSTOM_CLAIM=claim=value
# Environment=CHHOTO_OIDC_EXTRA_ORIGINS=https://example1.com,https://example2.com
Environment=CHHOTO_LISTEN_PORT=4567
#Environment=CHHOTO_LISTEN_ADDRESS=4567
#Environment=CHHOTO_API_KEY=SECURE_API_KEY 
Environment=CHHOTO_REDIRECT_METHOD=TEMPORARY 
Environment=CHHOTO_SLUG_STYLE=Pair 
#Environment=CHHOTO_SLUG_LENGTH=8 
#Environment=CHHOTO_TRY_LONGER_SLUG=False 
#Environment=CHHOTO_ALLOW_CAPITAL_LETTERS=False 
#Environment=CHHOTO_PUBLIC_MODE=Disable 
#Environment=CHHOTO_PUBLIC_MODE_EXPIRY_DELAY=3600 
#Environment=CHHOTO_EXTRA_PROTOCOLS=ftps,obsidian
#Environment=CHHOTO_DISABLE_FRONTEND=False 
#Environment=CHHOTO_CUSTOM_LANDING_DIRECTORY=/custom/dir/location 
#Environment=CHHOTO_CACHE_CONTROL_HEADER=no-cache,private
#Environment=CHHOTO_FRONTEND_PAGE_SIZE=10
#Environment=TZ=America/Chicago

# Volume
Volume=data:/data

# Health check
# Disable this if using the scratch images.
HealthCmd=CMD-SHELL wget -qO- http://127.0.0.1:1729/healthz || exit 1
HealthInterval=60s
HealthRetries=3
HealthStartPeriod=10s
HealthTimeout=10s
HealthOnFailure=kill

[Service]
Restart=on-failure
